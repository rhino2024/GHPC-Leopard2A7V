map_Kd textures/leo2a7v_gun_c.png
map_normal textures/leo2a7v_gun_n.png
map_ao textures/leo2a7v_gun_ao.png
map_ks textures/leo2a7v_gun_sm.png

newmtl ger_leopard_2a4_track
Kd 1.000 1.000 1.000
Ks 0.502 0.502 0.502
Ns 30
map_Kd textures/leo2a4_track_c.png
map_normal textures/leo2a4_track_n.png
map_ao textures/leo2a4_track_ao.png

# ger_leopard_2a5_phys_track is War Thunder's mass proxy for the track, welded 6 mm onto the inside of both
# side skirts (ex_armor_l/r_16). It is collision art, not visible art: left in, it draws a strip of track
# texture across the skirts a few millimetres from the hull skin, which reads as a panel of the wrong shade
# and z-fights at grazing angles. Its faces are dropped by the importer as an unlisted material.


map_ks textures/leo2a4_track_sm.png
