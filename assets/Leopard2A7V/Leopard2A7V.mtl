# Material assignments for the imported Leopard 2A7V art. The names have to match the usemtl lines
# in Leopard2A7V.obj; the maps are the War Thunder DDS set re-dressed by ModSources/tools/lp_texpass.py
# so the painted surfaces carry GHPC's own tone, band contrast, normal strength and gloss distribution
# (measured against the donor LEO2_co/_nm/_sm/_ao). map_ks is gloss-in-alpha, built from the diffuse's
# per-part material mask, which the export has but never referenced.
# net_f and net_j are deliberately absent - the turret camo netting is dropped by the parser.

newmtl leopard_2a7v_body_ger_camo_bronzegruen
Kd 1.000 1.000 1.000
Ks 0.502 0.502 0.502
Ns 30
map_Kd textures/leo2a7v_body_c.png
map_normal textures/leo2a7v_body_n.png
map_ao textures/leo2a7v_body_ao.png
map_ks textures/leo2a7v_body_sm.png

newmtl leopard_2a7v_turret_ger_camo_bronzegruen
Kd 1.000 1.000 1.000
Ks 0.502 0.502 0.502
Ns 30
map_Kd textures/leo2a7v_turret_c.png
map_normal textures/leo2a7v_turret_n.png
map_ao textures/leo2a7v_turret_ao.png
map_ks textures/leo2a7v_turret_sm.png

newmtl leopard_2a7v_gun_ger_camo_bronzegruen
Kd 1.000 1.000 1.000
